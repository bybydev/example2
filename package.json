{
  "name": "remotion-youtube-shorts-template",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion YouTube Shorts Template — vertical 9:16 YouTube Shorts built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "remotion render src/index.ts Main out/main.mp4",
    "thumbnail": "remotion still src/index.ts Thumbnail out/thumbnail.png",
    "normalize": "sh scripts/normalize-voiceover.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
